{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Event",
  "type": "object",
  "required": ["id", "type", "name", "timelineId", "participantIds"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "type": {"const": "event"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "timelineId": {"type": "string"},
    "participantIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "realmIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "causeEventIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "consequenceEventIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "order": {"type": "number"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
